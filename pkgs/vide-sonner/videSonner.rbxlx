          <Properties>
            <string name="Name">vide-ripple</string>
            <string name="Source"><![CDATA[local Ripple = require(script.Parent.Ripple)
local useMotion = require(script.useMotion)
local useSpring = require(script.useSpring)
local useTween = require(script.useTween)

export type Animatable = Ripple.Animatable
export type Easing = Ripple.Easing
export type Motion<T = any> = Ripple.Motion<T>
export type MotionOptions<T = any> = Ripple.MotionOptions<T>
export type Spring<T = any> = Ripple.Spring<T>
export type SpringOptions<T = any> = Ripple.SpringOptions<T>
export type Tween<T = any> = Ripple.Tween<T>
export type TweenOptions<T = any> = Ripple.TweenOptions<T>

return {
	config = Ripple.config,
	easing = Ripple.easing,
	createMotion = Ripple.createMotion,
	createSpring = Ripple.createSpring,
	createTween = Ripple.createTween,
	useMotion = useMotion,
	useSpring = useSpring,
	useTween = useTween,
}
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">useMotion</string>
              <string name="Source"><![CDATA[local Ripple = require(script.Parent.Parent.Ripple)
local Vide = require(script.Parent.Parent.Vide)

type Animatable = Ripple.Animatable
type Motion<T> = Ripple.Motion<T>
type MotionOptions<T> = Ripple.MotionOptions<T>

local function useMotion<T>(initialValue: T, initialOptions: MotionOptions<T>?): (() -> T, Motion<T>)
	local motion = Ripple.createMotion(initialValue, initialOptions)
	local value = Vide.source(initialValue)

	if not (initialOptions and initialOptions.start == false) then
		motion:start()
	end

	local disconnect = motion:onChange(value)

	Vide.cleanup(function()
		disconnect()
		motion:stop()
	end)

	return value, motion
end

return useMotion
]]></string>
            </Properties>
          </Item>
