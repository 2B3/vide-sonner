    <Item class="ModuleScript" referent="109">
      <Properties>
        <string name="Name">Ripple</string>
        <string name="Source">local module = require(script.Parent:FindFirstChild(".pesde"):FindFirstChild("littensy_vide-ripple@0.10.2"):FindFirstChild("vide-ripple"))
export type Animatable  = module.Animatable 
