        <string name="Name">Store</string>
        <string name="Source"><![CDATA[--- Services ---
const ReplicatedStorage = game:GetService("ReplicatedStorage")

--- Folders ---
const packages = ReplicatedStorage.Packages

--- Requires---
const Promise = require(packages.Promise)
const Reflex = require(packages.Reflex)
const Types = require("@self/Types")

--- Variables ---
const initialState = {
	suscribers = {},
	toasts = {},
	dismissedToasts = {},
}

local toastCounter = 0
local Store: ToastStore

--- Types ---
export type ToastStore = Reflex.Producer<State, Actions>

export type State = {
	suscribers: { Types.ToastT },
	toasts: { Types.ToastT },
	dismissedToasts: { [string | number]: boolean },
}

export type Actions = {
	addToast: (data: Types.ToastT) -> (),
	create: (data: Types.ToastT & { message: string?, type: Types.ToastType?, promise: Promise.Class? }) -> (),
	dismiss: (id: number | string?) -> (),

	message: (message: string, data: Types.ToastT) -> (),
	error: (message: string, data: Types.ToastT) -> (),
	success: (message: string, data: Types.ToastT) -> (),
	info: (message: string, data: Types.ToastT) -> (),
	warning: (message: string, data: Types.ToastT) -> (),
	loading: (message: string, data: Types.ToastT) -> (),
	promise: (promise: Promise.Class, data: Types.ToastT) -> (),
}

--- Utils ---
const function find<T>(array: { T }, predicate: (T) -> boolean): T?
	for _, value in array do
		if predicate(value) then
			return value
		end
	end

	return nil
end

const function resolveToastWithType(message: string?, data: Types.ToastT?, type: Types.ToastType)
	const toast = table.clone(data or {})

	toast.message = message
	toast.type = type

	return toast
end

local function createToast(
	state: State,
	data: Types.ToastT & {
		message: string?,
		type: Types.ToastType?,
		promise: Promise.Class?,
	}
): State
	const message = data.message
	const rest = table.clone(data)

	rest.message = nil

	const hasStringId = typeof(data.id) == "string" and data.id:len() > 0

	const id: number | string = (function()
		if hasStringId then
			return data.id
		end

		toastCounter += 1
		return toastCounter
	end)()

	const alreadyExists = find(state.toasts, function(toast)
		return toast.id == id
	end)

	const dismissible = data.dismissible ~= false

	const newState = table.clone(state)

	if state.dismissedToasts[id] then
		newState.dismissedToasts[id] = nil
	end

	if alreadyExists then
		for _, toast in state.toasts do
			if toast.id == id then
				const updatedToast = table.clone(toast)

				for key, value in data do
					updatedToast[key] = value
				end

				updatedToast.id = id
				updatedToast.dismissible = dismissible
				updatedToast.title = message

				const index = table.find(newState.toasts, toast)

				if index then
					newState.toasts[index] = updatedToast
				end

				break
			end
		end
	else
		local newToast = table.clone(rest)

		newToast.id = id
		newToast.title = message
		newToast.dismissible = dismissible

		table.insert(newState.toasts, newToast)
	end

	return newState
end

Store = Reflex.createProducer(initialState, {
	create = function(
		state: State,
		data: Types.ToastT & { message: string?, type: Types.ToastType?, promise: Promise.Class? }
	)
		return createToast(state, data)
	end,

	addToast = function(state: State, data: Types.ToastT)
		const newState = table.clone(state)

		table.insert(newState.toasts, data)

		return newState
	end,

	dismiss = function(state: State, id: number | string?)
		const newState = table.clone(state)

		if id then
			newState.dismissedToasts[id] = true
		else
			for _, toast in state.toasts do
				newState.dismissedToasts[toast.id] = true
			end
		end

		return newState
	end,

	remove = function(state: State, id: number | string?)
		const newState = table.clone(state)

		for i, toast in newState.toasts do
			if toast.id == id then
				table.remove(newState.toasts, i)
				newState.dismissedToasts[id] = nil

				break
			end
		end

		return newState
	end,

	message = function(state: State, message: string, data: Types.ToastT)
		return createToast(state, resolveToastWithType(message, data, nil))
	end,

	error = function(state: State, message: string, data: Types.ToastT)
		return createToast(state, resolveToastWithType(message, data, "error"))
	end,

	success = function(state: State, message: string, data: Types.ToastT)
		return createToast(state, resolveToastWithType(message, data, "success"))
	end,

	info = function(state: State, message: string, data: Types.ToastT)
		return createToast(state, resolveToastWithType(message, data, "info"))
	end,

	warning = function(state: State, message: string, data: Types.ToastT)
		return createToast(state, resolveToastWithType(message, data, "warning"))
	end,

	loading = function(state: State, message: string, data: Types.ToastT)
		return createToast(state, resolveToastWithType(message, data, "loading"))
	end,
}) :: ToastStore

return Store
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">Types</string>
        <string name="Source"><![CDATA[export type ToastType = "normal" | "success" | "info" | "warning" | "error" | "loading"

export type ToastT = {
	id: number | string,

	title: string?,
	description: string?,
	type: ToastType,

	duration: number,
	dismissible: boolean,
}

export type ToastProps = {
	toast: () -> ToastT,
	index: () -> number,

	maxToasts: () -> number,
	expanded: () -> boolean,
	offset: () -> number,
	toasts: () -> { ToastT },

	setHeight: (toastId: number | string, height: number) -> (),
	removeHeight: (toastId: number | string) -> (),

	removeToast: (toast: ToastT) -> (),
}

export type ToasterProps = {
	maxVisible: () -> number | number?,
	gap: () -> number | number?,
}

return {}
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">UI</string>
      </Properties>
      <Item class="Folder" referent="5">
        <Properties>
          <string name="Name">Components</string>
        </Properties>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Toast</string>
            <string name="Source"><![CDATA[--- Services ---
const ReplicatedStorage = game:GetService("ReplicatedStorage")

--- Folders ---
const features = ReplicatedStorage.shared.Features
const packages = ReplicatedStorage.Packages

--- Requires ---
const Ripple = require(packages.Ripple)
const Types = require(features.Toast.Types)
const Assets = require(features.Toast.Assets)
const Vide = require(packages.Vide)

--- Variables ---
const useSpring = Ripple.useSpring

const create = Vide.create
const effect = Vide.effect
const source = Vide.source
const show = Vide.show
const action = Vide.action
const changed = Vide.changed
const read = Vide.read

const SWIPE_THRESHOLD = 0.3

const TIME_BEFORE_UNMOUNT = 0.2
const TOAST_LIFETIME = 4

--- Utils ---
const function MoveDragger(
	progressPercent: (number?) -> number | number,
	sliderAbsSize: (Vector2?) -> Vector2 | Vector2,
	mousePosX: (number?) -> number | number
)
	local dragStartMouseX = 0
	local dragStartProgress = 0

	const function start(x: number)
		dragStartMouseX = x
		dragStartProgress = read(progressPercent) or 0
	end

	const function move(x: number?)
		const sliderAbsWidth = (read(sliderAbsSize) or Vector2.zero).X

		if sliderAbsWidth <= 0 then
			return
		end

		const currentMouseX = x or read(mousePosX) or dragStartMouseX
		const delta = (currentMouseX - dragStartMouseX) / sliderAbsWidth

		progressPercent(math.clamp(dragStartProgress + delta, 0, 1))
	end

	return start, move
end

--- Component ---
const function Toast(props: Types.ToastProps)
	const function onAbsSizeChanged(newSize: Vector2)
		local height = newSize.Y

		if height <= 0 then
			return
		end

		props.setHeight(read(props.toast).id, height)
	end

	const function isVisible()
		return (#read(props.toasts) - read(props.index)) < props.maxToasts
	end

	--> Remove <--
	const removed = source(false)
	const function deleteToast()
		if read(removed) then
			return
		end

		removed(true)

		task.delay(TIME_BEFORE_UNMOUNT, function()
			props.removeToast(read(props.toast))
		end)
	end
	task.delay(TOAST_LIFETIME, deleteToast)

	--> Dragging <--
	const swiping = source(false)
	const swipeOut = source(false)

	const progressPercent = source(0)
	const toastAbsSize = source(0)
	const toastAbsPos = source(0)
	const mousePosX = source(0)

	const startDragging, moveDragger = MoveDragger(progressPercent, toastAbsSize, mousePosX)

	const progressSmooth, progressSmoothSpring = useSpring(progressPercent(), Ripple.config.stiff)
	effect(function()
		const currentProgressPercent = read(progressPercent)
		progressSmoothSpring:setGoal(currentProgressPercent)
	end)

	const function stopDragging()
		if not read(swiping) then
			return
		end

		const currentPercent = read(progressPercent)

		mousePosX(0)
		moveDragger(0)
		swiping(false)

		if read(removed) or currentPercent <= SWIPE_THRESHOLD then
			return
		end

		swipeOut(true)
		deleteToast()
	end

	--> Icon <--
	const function getIcon(): index<typeof(Assets), keyof<typeof(Assets)>>?
		const type = read(props.toast).type
		const icon = Assets["icons/" .. type] :: index<typeof(Assets), concat<"icons/", Types.ToastType>>?
		if not icon then
			return {}
		end

		return icon
	end

	--> Animations <--
	const getOffset, offsetSpring = useSpring(0, Ripple.config.stiff)
	const getScale, scaleSpring = useSpring(0.6, Ripple.config.stiff)

	const getAnchor, anchorSpring = useSpring(Vector2.new(0.5, 0), Ripple.config.stiff)
	const getPosition, positionSpring = useSpring(UDim2.fromScale(0.5, 1), Ripple.config.stiff)

	positionSpring:setGoal(UDim2.fromScale(0.5, 0.5))
	anchorSpring:setGoal(Vector2.one * 0.5)

	effect(function()
		anchorSpring:setGoal(read(swipeOut) and Vector2.new(0, 0.5) or Vector2.one * 0.5)
		positionSpring:setGoal(read(swipeOut) and UDim2.fromScale(1, 0.5) or UDim2.fromScale(0.5, 0.5))

		const scale = if read(swipeOut)
			then 1
			elseif read(removed) then 0
			elseif isVisible() and read(props.expanded) then 1
			elseif isVisible() then 1 - (#read(props.toasts) - read(props.index)) * 0.05
			else 0

		offsetSpring:setGoal(
			if read(removed) and not read(swipeOut)
				then 0
				elseif read(props.expanded) then read(props.offset)
				else read(props.offset) * 0.08 + 16
		)

		scaleSpring:setGoal(scale)
	end)

	return show(isVisible, function()
		return create("Frame")({
			Name = function()
				return string.format("Toast %s", tostring(read(props.toast).id))
			end,

			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.fromOffset(356, 0),
			BackgroundTransparency = 1,

			ZIndex = function()
				return read(props.index) - #read(props.toasts)
			end,

			Position = function()
				return UDim2.fromOffset(0, getOffset())
			end,

			create("UIPadding")({
				PaddingBottom = UDim.new(0, 16),
				PaddingRight = UDim.new(0, 16),
				PaddingLeft = UDim.new(0, 16),
				PaddingTop = UDim.new(0, 16),
			}),

			create("TextButton")({
				Name = "Content",
				Text = "",

				BackgroundColor3 = Color3.fromHex("eeeeee"),
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.fromScale(1, 0),
				Position = getPosition,
				AnchorPoint = function()
					return getAnchor() + Vector2.xAxis * -read(progressSmooth)
				end,

				MouseMoved = function(x)
					if not read(swiping) then
						return
					end

					mousePosX(x)
					moveDragger(x)
				end,

				MouseButton1Down = function(x: number)
					startDragging(x)
					swiping(true)
				end,

				MouseButton1Up = stopDragging,
				MouseLeave = stopDragging,

				action(function(ref: TextButton)
					toastAbsPos(ref.AbsolutePosition)
					toastAbsSize(ref.AbsoluteSize)
				end),

				changed("AbsolutePosition", toastAbsPos),
				changed("AbsoluteSize", toastAbsSize),

				changed("AbsoluteSize", onAbsSizeChanged),

				create("UIPadding")({
					PaddingBottom = UDim.new(0, 16),
					PaddingRight = UDim.new(0, 16),
					PaddingLeft = UDim.new(0, 16),
					PaddingTop = UDim.new(0, 16),
				}),

				create("UIShadow")({
					BlurRadius = UDim.new(0, 16),
					Transparency = 0.8,
				}),

				create("UIStroke")({
					BorderStrokePosition = Enum.BorderStrokePosition.Center,
					Color = Color3.fromHex("#a4a4a4"),
				}),

				create("UIScale")({
					Scale = getScale,
				}),

				create("UICorner")({
					CornerRadius = UDim.new(0, 8),
				}),

				show(function()
					return read(props.toast).type
				end, function()
					return create("ImageLabel")({
						Name = "Icon",

						Position = UDim2.fromScale(0, 0.5),
						AnchorPoint = Vector2.yAxis * 0.5,
						Size = UDim2.fromOffset(20, 20),
						BackgroundTransparency = 1,

						Image = function()
							return getIcon().Image
						end,

						ImageRectOffset = function()
							return getIcon().ImageRectOffset
						end,

						ImageRectSize = function()
							return getIcon().ImageRectSize
						end,
					})
				end),

				create("Frame")({
					Name = "TextsContainer",

					AutomaticSize = Enum.AutomaticSize.Y,
					Position = UDim2.fromScale(1, 0),
					Size = function()
						return UDim2.new(1, read(props.toast).type and -25, 0, 0)
					end,
					AnchorPoint = Vector2.xAxis,
					BackgroundTransparency = 1,

					create("UIListLayout")({
						HorizontalAlignment = Enum.HorizontalAlignment.Left,
						Padding = UDim.new(0, 4),
					}),

					create("TextLabel")({
						Name = "Title",

						TextXAlignment = Enum.TextXAlignment.Left,
						AutomaticSize = Enum.AutomaticSize.XY,
						Text = function()
							return read(props.toast).title or ""
						end,
						BackgroundTransparency = 1,
						TextSize = 14,

						FontFace = Font.new("rbxasset://fonts/families/Roboto.json", Enum.FontWeight.Medium),
						TextColor3 = Color3.fromHex("121212"),
					}),

					show(function()
						return read(props.toast).description
					end, function(description: () -> string)
						return create("TextLabel")({
							Name = "Description",

							TextXAlignment = Enum.TextXAlignment.Left,
							TextTruncate = Enum.TextTruncate.AtEnd,
							AutomaticSize = Enum.AutomaticSize.XY,
							BackgroundTransparency = 1,
							Text = description or "",
							TextWrapped = true,
							TextSize = 14,

							FontFace = Font.new("rbxasset://fonts/families/Roboto.json", Enum.FontWeight.Regular),
							TextColor3 = Color3.fromHex("121212"),
						})
					end),
				}),
			}),
		})
	end)
end

return Toast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Toaster</string>
            <string name="Source"><![CDATA[--- Services ---
const ReplicatedStorage = game:GetService("ReplicatedStorage")

--- Folders ---
const features = ReplicatedStorage.shared.Features
const packages = ReplicatedStorage.Packages

--- Requires ---
const Store = require(features.Toast.Store)
const Types = require(features.Toast.Types)
const Vide = require(packages.Vide)

const Toast = require("@self/Toast")

--- Variables ---
const values = Vide.values
const source = Vide.source
const effect = Vide.effect
const create = Vide.create
const chanded = Vide.changed
const read = Vide.read

--- Component ---
const function Toaster(props: Types.ToasterProps)
	--> Default Props <--
	props.maxVisible = props.maxVisible or 3
	props.gap = props.gap or 8

	--> Toast State <--
	const toastStore = source(Store:getState())

	effect(function()
		return Store:subscribe(function(state)
			return state
		end, function(state)
			toastStore(state)
		end)
	end)

	--> Heights <--
	const heights = source({}) :: Vide.Source<{ [number | string]: number }>
	const expanded = source(true)

	const function setHeight(id: number | string, height: number)
		const current = table.clone(read(heights))
		current[id] = height

		heights(current)
	end

	const function getOffset(index: number)
		const currentHeights = read(heights)
		const toasts = read(toastStore).toasts

		local offset = 0

		for i = 1, index - 1 do
			const height = currentHeights[toasts[i].id]

			if height then
				offset += height + read(props.gap)
			end
		end

		return offset
	end

	return create("Frame")({
		Name = "Toaster",

		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,

		--> ToastList <--
		create("Frame")({
			Name = "ToastsList",

			BackgroundColor3 = Color3.fromHex("ff8800"),
			AutomaticSize = Enum.AutomaticSize.XY,
			Position = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.one,
			BorderColor3 = Color3.fromHex("ff6600"),
			BorderSizePixel = 1,

			create("UIPadding")({
				PaddingBottom = UDim.new(0, 16),
				PaddingRight = UDim.new(0, 4),
				PaddingLeft = UDim.new(0, 8),
				PaddingTop = UDim.new(0, 8),
			}),

			chanded("GuiState", function(state: Enum.GuiState)
				expanded(state ~= Enum.GuiState.Idle)
			end),

			--> Toasts <--
			values(function()
				return read(toastStore).toasts
			end, function(toast: () -> Types.ToastT, index: () -> number)
				return Toast({
					toast = toast,
					index = index,

					maxToasts = props.maxVisible,
					setHeight = setHeight,
					expanded = expanded,

					offset = function()
						return getOffset(read(index))
					end,

					toasts = function()
						return read(toastStore).toasts
					end,

					removeToast = function(removedToast: Types.ToastT)
						Store.remove(removedToast.id)
					end,
				})
			end),
		}),
	})
end

return Toaster
]]></string>
          </Properties>
        </Item>
